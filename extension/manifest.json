{
  "manifest_version": 3,
  "name": "Signals Inspector",
  "short_name": "Signals",
  "description": "Inspect TC39 Signals on a page: the dependency graph, every write, and why each computed re-ran. Framework-neutral.",
  "version": "0.1.0",
  "devtools_page": "devtools.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://*.localhost/*",
        "https://*.localhost/*",
        "file:///*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "signals-inspector@journeytocode.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
